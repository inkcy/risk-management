# PostgreSQL connection string (Vercel Postgres / Neon / Supabase)
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- การเข้าสู่ระบบด้วย Google ----
# สร้าง OAuth client (ประเภท Web application) ที่ https://console.cloud.google.com/apis/credentials
# Authorized redirect URI ต้องใส่ให้ครบทั้งสองอัน:
#   http://localhost:3000/api/auth/callback/google
#   https://<โดเมนจริงของคุณ>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# กุญแจเซ็น session cookie — ต้องยาว >= 32 ตัวอักษร และห้ามเปิดเผย
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# โดเมนจริงของเว็บ (บังคับให้ redirect_uri ตรงกับที่ลงทะเบียนไว้เสมอ)
# ตอน dev เว้นว่างได้ ระบบจะใช้โดเมนที่เปิดเข้ามา
APP_URL=

# จำกัดโดเมนอีเมลที่เข้าได้ คั่นด้วย comma เช่น hospital.go.th
# เว้นว่าง = ใครมี Google account ก็ล็อกอินได้ (ได้สิทธิ์ผู้ดูอย่างเดียว) — ไม่แนะนำสำหรับข้อมูลผู้ป่วย
ALLOWED_EMAIL_DOMAINS=

# อีเมลที่จะเป็น admin อัตโนมัติเมื่อล็อกอิน คั่นด้วย comma — ใส่อีเมลตัวเองก่อนใช้งานครั้งแรก
ADMIN_EMAILS=

# ---- Gemini API key สำหรับฟีเจอร์ AI วิเคราะห์ RCA (เว้นว่าง = ใช้ mock) ----
# สร้าง API key ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (optional) override default model gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash
