PORT=4000
# Postgres connection string (Neon / Vercel / local)
POSTGRES_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# CORS allowed origins (comma separated). Default: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Claude API (สำหรับฟีเจอร์ AI วิเคราะห์ RCA) — ไม่ใส่ = demo mode (mock)
# สมัคร + เติมเครดิตที่ https://console.anthropic.com
ANTHROPIC_API_KEY=
# Override model (default: claude-sonnet-4-6)
# ทางเลือก: claude-haiku-4-5 (ถูกสุด), claude-opus-4-8 (แพงสุด/ฉลาดสุด)
ANTHROPIC_MODEL=claude-sonnet-4-6
