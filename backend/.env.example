PORT=4000
# Postgres connection string (Neon / Vercel / local)
POSTGRES_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# CORS allowed origins (comma separated). Default: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Gemini API (สำหรับฟีเจอร์ AI วิเคราะห์ RCA) — ไม่ใส่ = demo mode (mock)
# สร้าง API key ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Override model (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
