# PostgreSQL connection string (Vercel Postgres / Neon / Supabase)
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require

# Anthropic API key สำหรับฟีเจอร์ AI วิเคราะห์ RCA
ANTHROPIC_API_KEY=sk-ant-...

# (optional) override default model claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6
